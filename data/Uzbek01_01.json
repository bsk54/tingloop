      "lines": [
        {
          "id": 1,
          "type": "title",
          "original": "Salomlashish va hol-ahvol soʻrash",
          "zh": "打招呼和问候近况",
          "en": "Greetings and asking how someone is",
          "ar": "التحية والسؤال عن الأحوال",
          "hi": "अभिवादन और हालचाल पूछना",
          "kk": "Сәлемдесу және хал-жағдай сұрасу",
          "ko": "인사와 안부 묻기",
          "ky": "Саламдашуу жана ал-жай сурашуу",
          "ru": "Приветствия и вопрос «Как дела?»",
          "tg": "Салом ва аҳволпурсӣ",
          "tr": "Selamlaşma ve hâl hatır sorma",
          "tk": "Salamlaşmak we hal-ahwal soraşmak",
          "ur": "سلام دعا اور حال احوال پوچھنا"
        },
        {
          "id": 2,
          "type": "line",
          "original": "Assalomu alaykum!",
          "pinyin": "/assalɔˈmu alajˈkum/",
          "zh": "您好！",
          "en": "Hello!",
          "ar": "السلام عليكم!",
          "hi": "नमस्ते!",
          "kk": "Ассалаумағалейкум!",
          "ko": "안녕하세요!",
          "ky": "Ассалому алейкум!",
          "ru": "Здравствуйте!",
          "tg": "Ассалому алайкум!",
          "tr": "Selamünaleyküm!",
          "tk": "Essalawmaleýkim!",
          "ur": "السلام علیکم!"
        },
        {
          "id": 3,
          "type": "line",
          "original": "Va alaykum assalom!",
          "pinyin": "/va alajˈkum assaˈlɔm/",
          "zh": "您好！（回应问候）",
          "en": "Hello! (in reply)",
          "ar": "وعليكم السلام!",
          "hi": "नमस्ते! (जवाब में)",
          "kk": "Уағалейкумассалам!",
          "ko": "안녕하세요! (인사에 대한 답)",
          "ky": "Алейкум ассалам!",
          "ru": "Здравствуйте!",
          "tg": "Ва алайкум ассалом!",
          "tr": "Aleykümselam!",
          "tk": "Waleýkimessalam!",
          "ur": "وعلیکم السلام!"
        },
        {
          "id": 4,
          "type": "line",
          "original": "Salom!",
          "pinyin": "/saˈlɔm/",
          "zh": "你好！",
          "en": "Hi!",
          "ar": "مرحبًا!",
          "hi": "नमस्ते!",
          "kk": "Сәлем!",
          "ko": "안녕!",
          "ky": "Салам!",
          "ru": "Привет!",
          "tg": "Салом!",
          "tr": "Selam!",
          "tk": "Salam!",
          "ur": "سلام!"
        },
        {
          "id": 5,
          "type": "line",
          "original": "Qalaysiz?",
          "pinyin": "/qaˈlajsiz/",
          "zh": "您最近怎么样？",
          "en": "How are you? (formal)",
          "ar": "كيف حالك؟",
          "hi": "आपका क्या हाल है?",
          "kk": "Қалайсыз?",
          "ko": "잘 지내세요?",
          "ky": "Кандайсыз?",
          "ru": "Как у вас дела?",
          "tg": "Шумо чӣ хелед?",
          "tr": "Nasılsınız?",
          "tk": "Nähilisiňiz?",
          "ur": "آپ کا کیا حال ہے؟"
        },
        {
          "id": 6,
          "type": "line",
          "original": "Yaxshi, rahmat.",
          "pinyin": "/jaχˈʃi rahˈmat/",
          "zh": "挺好的，谢谢。",
          "en": "Fine, thank you.",
          "ar": "أنا بخير، شكرًا.",
          "hi": "मैं ठीक हूँ, धन्यवाद।",
          "kk": "Жақсы, рақмет.",
          "ko": "잘 지내요, 감사합니다.",
          "ky": "Жакшы, рахмат.",
          "ru": "Хорошо, спасибо.",
          "tg": "Хуб, раҳмат.",
          "tr": "İyiyim, teşekkür ederim.",
          "tk": "Gowy, sag boluň.",
          "ur": "میں ٹھیک ہوں، شکریہ۔"
        },
        {
          "id": 7,
          "type": "line",
          "original": "Oʻzingiz-chi?",
          "pinyin": "/oziˈŋiztʃi/",
          "zh": "您呢？",
          "en": "And you?",
          "ar": "وأنت؟",
          "hi": "और आप?",
          "kk": "Өзіңіз ше?",
          "ko": "그럼, 어떠세요?",
          "ky": "Өзүңүзчү?",
          "ru": "А у вас?",
          "tg": "Худатон чӣ?",
          "tr": "Ya siz?",
          "tk": "Siz nähili?",
          "ur": "اور آپ؟"
        },
        {
          "id": 8,
          "type": "line",
          "original": "Men ham yaxshiman.",
          "pinyin": "/men ham jaχˈʃiman/",
          "zh": "我也挺好的。",
          "en": "I'm fine too.",
          "ar": "وأنا بخير أيضًا.",
          "hi": "मैं भी ठीक हूँ।",
          "kk": "Мен де жақсымын.",
          "ko": "저도 잘 지내요.",
          "ky": "Мен да жакшымын.",
          "ru": "У меня тоже всё хорошо.",
          "tg": "Ман ҳам хубам.",
          "tr": "Ben de iyiyim.",
          "tk": "Men hem gowy.",
          "ur": "میں بھی ٹھیک ہوں۔"
        },
        {
          "id": 9,
          "type": "line",
          "original": "Qalaysan?",
          "pinyin": "/qaˈlajsan/",
          "zh": "你最近怎么样？",
          "en": "How are you? (informal)",
          "ar": "كيف حالك؟",
          "hi": "तुम्हारा क्या हाल है?",
          "kk": "Қалайсың?",
          "ko": "잘 지내?",
          "ky": "Кандайсың?",
          "ru": "Как у тебя дела?",
          "tg": "Ту чӣ хелӣ?",
          "tr": "Nasılsın?",
          "tk": "Nähilisiň?",
          "ur": "تمہارا کیا حال ہے؟"
        },
        {
          "id": 10,
          "type": "line",
          "original": "Yomon emas.",
          "pinyin": "/jɔˈmɔn eˈmas/",
          "zh": "还不错。",
          "en": "Not bad.",
          "ar": "ليس سيئًا.",
          "hi": "बुरा नहीं।",
          "kk": "Жаман емес.",
          "ko": "나쁘지 않아.",
          "ky": "Жаман эмес.",
          "ru": "Неплохо.",
          "tg": "Бад нест.",
          "tr": "Fena değil.",
          "tk": "Erbet däl.",
          "ur": "برا نہیں۔"
        },
        {
          "id": 11,
          "type": "line",
          "original": "Koʻrishguncha!",
          "pinyin": "/koriʃɡunˈtʃa/",
          "zh": "再见！",
          "en": "See you!",
          "ar": "إلى اللقاء!",
          "hi": "फिर मिलेंगे!",
          "kk": "Көріскенше!",
          "ko": "또 봐요!",
          "ky": "Көрүшкөнчө!",
          "ru": "До встречи!",
          "tg": "То боздид!",
          "tr": "Görüşürüz!",
          "tk": "Görüşýänçäk!",
          "ur": "پھر ملیں گے!"
        }
      ]
    },
