      "lines": [
        {
          "id": 1,
          "type": "title",
          "original": "Bir-birini tushunish",
          "zh": "互相理解",
          "en": "Understanding each other",
          "ar": "التفاهم",
          "hi": "एक-दूसरे को समझना",
          "kk": "Бір-бірін түсіну",
          "ko": "서로 이해하기",
          "ky": "Бири-бирин түшүнүү",
          "ru": "Как понять друг друга",
          "tg": "Якдигарро фаҳмидан",
          "tr": "Birbirini anlamak",
          "tk": "Birek-birege düşünmek",
          "ur": "ایک دوسرے کو سمجھنا"
        },
        {
          "id": 2,
          "type": "line",
          "original": "Tushunmadim.",
          "pinyin": "/tuˈʃunmadim/",
          "zh": "我没听懂。",
          "en": "I didn't understand.",
          "ar": "لم أفهم.",
          "hi": "समझ में नहीं आया।",
          "kk": "Түсінбедім.",
          "ko": "못 알아들었어요.",
          "ky": "Түшүнгөн жокмун.",
          "ru": "Я не понял(а).",
          "tg": "Нафаҳмидам.",
          "tr": "Anlamadım.",
          "tk": "Düşünmedim.",
          "ur": "مجھے سمجھ نہیں آئی۔"
        },
        {
          "id": 3,
          "type": "line",
          "original": "Yana bir marta ayting, iltimos.",
          "pinyin": "/jaˈna bir marˈta ajˈtiŋ iltiˈmɔs/",
          "zh": "请再说一遍。",
          "en": "Please say it again.",
          "ar": "قلها مرة أخرى، من فضلك.",
          "hi": "कृपया एक बार फिर कहिए।",
          "kk": "Тағы бір рет айтыңызшы.",
          "ko": "한 번 더 말씀해 주세요.",
          "ky": "Дагы бир жолу айтыңызчы.",
          "ru": "Скажите ещё раз, пожалуйста.",
          "tg": "Боз як бор гӯед, лутфан.",
          "tr": "Bir daha söyler misiniz, lütfen?",
          "tk": "Haýyş, ýene bir gezek aýdyň.",
          "ur": "براہِ کرم ایک بار پھر کہیں۔"
        },
        {
          "id": 4,
          "type": "line",
          "original": "Sekinroq gapiring, iltimos.",
          "pinyin": "/sekinˈrɔq ɡapiˈriŋ iltiˈmɔs/",
          "zh": "请说慢一点。",
          "en": "Please speak more slowly.",
          "ar": "تكلم ببطء أكثر، من فضلك.",
          "hi": "कृपया थोड़ा धीरे बोलिए।",
          "kk": "Ақырындау сөйлеңізші.",
          "ko": "조금 천천히 말씀해 주세요.",
          "ky": "Жайыраак сүйлөңүзчү.",
          "ru": "Говорите помедленнее, пожалуйста.",
          "tg": "Лутфан, каме оҳистатар гап занед.",
          "tr": "Lütfen biraz daha yavaş konuşun.",
          "tk": "Haýyş, biraz haýalrak gürläň.",
          "ur": "براہِ کرم ذرا آہستہ بولیں۔"
        },
        {
          "id": 5,
          "type": "line",
          "original": "Bu nimani anglatadi?",
          "pinyin": "/bu nimaˈni aŋlaˈtadi/",
          "zh": "这是什么意思？",
          "en": "What does this mean?",
          "ar": "ماذا يعني هذا؟",
          "hi": "इसका क्या मतलब है?",
          "kk": "Бұл нені білдіреді?",
          "ko": "이게 무슨 뜻이에요?",
          "ky": "Бул эмнени билдирет?",
          "ru": "Что это значит?",
          "tg": "Ин чӣ маъно дорад?",
          "tr": "Bu ne anlama geliyor?",
          "tk": "Bu nämäni aňladýar?",
          "ur": "اس کا کیا مطلب ہے؟"
        },
        {
          "id": 6,
          "type": "line",
          "original": "Buni oʻzbekcha qanday aytishadi?",
          "pinyin": "/buˈni ozbekˈtʃa qanˈdaj ajtiˈʃadi/",
          "zh": "这个用乌兹别克语怎么说？",
          "en": "How do you say this in Uzbek?",
          "ar": "كيف يُقال هذا بالأوزبكية؟",
          "hi": "इसे उज़्बेक में कैसे कहते हैं?",
          "kk": "Мұны өзбекше қалай айтады?",
          "ko": "이걸 우즈베크어로 어떻게 말해요?",
          "ky": "Муну өзбекче кантип айтышат?",
          "ru": "Как это сказать по-узбекски?",
          "tg": "Инро ба ӯзбекӣ чӣ мегӯянд?",
          "tr": "Bunu Özbekçe nasıl söylersiniz?",
          "tk": "Muny özbekçe nähili aýdýarlar?",
          "ur": "اسے ازبک میں کیسے کہتے ہیں؟"
        },
        {
          "id": 7,
          "type": "line",
          "original": "Qanday yoziladi?",
